# Required. Use only a token belonging to an officially approved TETR.IO bot account.
TETRIO_BOT_TOKEN=

# Required after receiving written approval for this bot's private-room scope.
# Set exactly: I_HAVE_WRITTEN_TETRIO_STAFF_APPROVAL
TETRIO_STAFF_APPROVAL=

# Optional. Leave blank to create a new private custom room on startup.
TETRIO_ROOM_ID=

# Safe defaults for the deterministic baseline.
TETRIO_BOT_PPS=3.8
AI_LOOKAHEAD=3
AI_BEAM_WIDTH=12
AI_TIME_BUDGET_MS=12

# Set to 1 only while diagnosing live move decisions.
BOT_DEBUG=0
